# Copy to .env and fill in. Only MONGODB_URI and the admin credentials are
# needed to run the shop; the payment keys come later.

# --- Required ---------------------------------------------------------------

# MongoDB connection string. A free Atlas cluster is plenty to start:
#   https://www.mongodb.com/cloud/atlas  →  Create → M0 (free) → Connect → Drivers
# Use the whole string including the password. No database name needed; the API
# uses "sketchover" unless the URI names one.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net

# Signs the admin session. Any long random string.
JWT_SECRET=change-me-to-something-long-and-random

# Who can sign in to the admin panel.
ADMIN_EMAIL=admin@sketchover.in
ADMIN_PASSWORD=change-me

# --- Optional ---------------------------------------------------------------

# Port the API listens on (hosts usually set this themselves).
PORT=4000

# Payment gateways — leave blank until you are ready to take card payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# Cloudinary is no longer used: pictures and videos are stored in MongoDB
# itself (GridFS), so the database is the only thing a deploy depends on.
