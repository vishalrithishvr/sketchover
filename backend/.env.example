# For running the API on your own machine (npm start). The live API on Netlify
# reads the same names from the site's environment variables instead.

# Who can sign in to the admin panel.
ADMIN_EMAIL=Skoadmin
ADMIN_PASSWORD=change-me

# Signs the admin session. Any long random string.
JWT_SECRET=change-me-to-something-long-and-random

# Port the local API listens on.
PORT=4000

# Payment gateway — leave blank until card payments are switched on.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
